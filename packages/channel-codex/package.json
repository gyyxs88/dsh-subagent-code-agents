{
  "name": "@dsh-subagent-code-agents/channel-codex",
  "version": "0.1.1",
  "description": "Codex channel adapter: runs OpenAI Codex CLI behind the multi-channel coding-agent core (no DSH/Cordis dependency)",
  "dsh": { "remote": { "channelRuntime": { "schemaVersion": "1.0", "runtimeId": "codex", "placement": "remote", "protocolVersion": "1.0", "driver": "codex", "authPolicy": "remote-user", "capabilities": ["exec", "app-server", "approval-requests"], "compatibility": { "dsh": { "min": "0.1.0-rc.6", "max": "0.1.0-rc.8" }, "api": { "min": "1.0", "max": "1.0" } } } } },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./app-server": {
      "types": "./lib/app-server-channel.d.ts",
      "default": "./lib/app-server-channel.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/index.d.ts",
    "lib/app-server-channel.js",
    "lib/app-server-channel.d.ts",
    "lib/app-server-protocol.js",
    "protocol/codex-0.147.0/**",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test --test-isolation=none"
  },
  "dependencies": {
    "@dsh-subagent-code-agents/core": "0.1.1"
  },
  "license": "MIT",
  "keywords": [
    "codex",
    "openai",
    "subagent",
    "channel"
  ],
  "engines": {
    "node": ">=24"
  }
}
