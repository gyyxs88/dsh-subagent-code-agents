{
  "name": "@dsh-subagent-code-agents/channel-codex",
  "version": "0.1.0",
  "description": "Codex channel adapter: runs OpenAI Codex CLI behind the multi-channel coding-agent core (no DSH/Cordis dependency)",
  "dsh": { "remote": { "runtime": { "id": "codex", "runtimeId": "codex", "version": "0.1.0", "placement": "remote", "target": "linux-x86_64", "protocolVersion": "1.0", "driver": "codex", "authPolicy": "remote-user", "executablePath": "bin/codex", "capabilities": ["exec", "app-server", "approval-requests"], "requiredBy": ["channel:codex"] } } },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./app-server": {
      "types": "./lib/app-server-channel.d.ts",
      "default": "./lib/app-server-channel.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/index.d.ts",
    "lib/app-server-channel.js",
    "lib/app-server-channel.d.ts",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test --test-isolation=none"
  },
  "dependencies": {
    "@dsh-subagent-code-agents/core": "0.1.0"
  },
  "license": "MIT",
  "keywords": [
    "codex",
    "openai",
    "subagent",
    "channel"
  ],
  "engines": {
    "node": ">=24"
  }
}
